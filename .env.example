# URL de conexión a la base de datos PostgreSQL en Neon con modo SSL estricto
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=verify-full

# Identificador de la rama aislada de Neon para correr migraciones y pruebas de forma segura
NEON_TEST_BRANCH_ID=br-ejemplo-branch-id

# Clave secreta para la firma y verificación de tokens JWT (mínimo 32 caracteres recomendados)
JWT_SECRET=tu-clave-secreta-para-firmar-jwt

# Contraseña inicial asignada al usuario administrador por defecto (ADMIN001)
ADMIN_INITIAL_PASSWORD=tu-password-inicial-admin

# Origen permitido para solicitudes CORS desde el cliente frontend
CORS_ORIGIN=http://localhost:5173

# Configuración de avisos por correo electrónico
EMAIL_TRANSPORTE=simulado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SEGURO=true
SMTP_USUARIO=ejemplo@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_REMITENTE="Sistema de Mantenimiento <avisos@ejemplo.com>"
APP_URL_PUBLICA=http://localhost:5173
